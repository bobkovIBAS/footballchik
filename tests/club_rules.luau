local Rules = require("../src/shared/ClubRules")
local data = { owned = 0, boots = 0, club = Rules.normalize(nil) }
local club = data.club
assert(Rules.isNewKick(1, 0) and Rules.isNewKick(3, 1))
assert(not Rules.isNewKick(1, 1) and not Rules.isNewKick(1, 2))
assert(not Rules.isNewKick("2", 1) and not Rules.isNewKick(1.5, 1))
assert(not Rules.isNewKick(0/0, 1) and not Rules.isNewKick(math.huge, 1))
assert(Rules.training(data) == 1)
assert(Rules.day(86399) == 0 and Rules.day(86400) == 1)
Rules.onKick(club, true, 0)
assert(Rules.training(data) == 2 and club.gold == 1)
data.boots = 1
assert(Rules.training(data) == 3)
data.owned = 1
assert(Rules.training(data) == 4)
for _ = 1, 4 do Rules.onKick(club, true, 1) end
assert(club.gold == Rules.GoldForHeel)
assert(Rules.normalize({ trick = 2 }).trick == 1)
assert(Rules.normalize({ trick = 2, gold = 3 }).trick == 2)

assert(Rules.roll(club, 50))
assert(not Rules.choose(club, 49, 1) and not Rules.choose(club, 50, 4))
assert(Rules.choose(club, 50, 2) and not Rules.choose(club, 50, 1))
assert(not Rules.claim(club, 50))
Rules.onKick(club, false, 3)
assert(club.daily.count == 0)
Rules.onKick(club, true, 3)
assert(club.daily.count == 2)
Rules.onKick(club, true, 3)
assert(Rules.claim(club, 50) and not Rules.claim(club, 50))
local loaded = Rules.normalize(club)
assert(loaded.marks == 1 and loaded.daily.claimed and not Rules.claim(loaded, 50))
assert(not Rules.roll(loaded, 49) and Rules.roll(loaded, 51))
assert(not Rules.claim(loaded, 50) and loaded.marks == 1)
assert(Rules.choose(loaded, 51, 3))
Rules.onKick(loaded, false, 0)
assert(loaded.daily.count == 0)
Rules.onKick(loaded, false, 2)
assert(loaded.daily.count == 2)

local round = Rules.newRhythm(100, 1, 1)
assert(round.window > Rules.newRhythm(100, 2, 1).window)
assert(not Rules.beat(round, 100, 0))
local first = Rules.beat(round, round.start + 0.08, 0.08)
assert(first.grade == "Perfect" and Rules.RhythmPower[first.grade] == 5 and round.combo == 1)
assert(not Rules.beat(round, round.start + 0.10, 0))
local second = Rules.beat(round, round.start + Rules.BeatInterval + 0.15, 0)
assert(second.grade == "Good" and Rules.RhythmPower[second.grade] == 2 and round.combo == 2)
local third = Rules.beat(round, round.start + 2 * Rules.BeatInterval + 0.30, 0)
assert(third.grade == "Miss" and Rules.RhythmPower[third.grade] == 0 and round.combo == 0)
assert(round.bestCombo == 2 and Rules.score(round) == 1)
assert(Rules.beat(round, round.start + 3 * Rules.BeatInterval, 0).grade == "Perfect")
assert(Rules.expireBeats(round, round.start + 4.5 * Rules.BeatInterval + Rules.MaxRhythmCompensation + 0.001))
assert(round.last.grade == "Miss" and round.combo == 0 and Rules.score(round) == 2)

local perfect = Rules.newRhythm(100, 0, 2)
for i = 0, 7 do Rules.beat(perfect, perfect.start + i * Rules.BeatInterval, 0) end
assert(Rules.score(perfect) == 8 and perfect.bestCombo == 8)
assert(not Rules.beat(perfect, perfect.finish, 0))
local capped = Rules.newRhythm(100, 0, 3)
assert(Rules.beat(capped, capped.start + 0.28, 10).grade == "Good")
print("Club rules: onboarding, finisher unlock, daily rewards, rhythm grades, combo, expiry and latency cap passed")
